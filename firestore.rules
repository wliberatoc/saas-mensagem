rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    function ownsNewDocument() {
      return isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    function connectionBelongsToUser(connectionId) {
      return connectionId is string
        && exists(/databases/$(database)/documents/connections/$(connectionId))
        && get(/databases/$(database)/documents/connections/$(connectionId)).data.clientId == request.auth.uid;
    }

    function hasValidConnectionData() {
      return request.resource.data.keys().hasAll([
          'clientId', 'name', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId', 'name', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidContactData() {
      return request.resource.data.keys().hasAll([
          'clientId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.connectionId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidMessageData() {
      return request.resource.data.keys().hasAll([
          'clientId', 'connectionId', 'content', 'recipient', 'status',
          'scheduledAt', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId', 'connectionId', 'content', 'recipient', 'status',
          'scheduledAt', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.connectionId is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.recipient is map
        && request.resource.data.recipient.keys().hasAll(['contactId', 'name', 'phone'])
        && request.resource.data.recipient.keys().hasOnly(['contactId', 'name', 'phone'])
        && request.resource.data.recipient.contactId is string
        && request.resource.data.recipient.contactId.size() > 0
        && request.resource.data.recipient.name is string
        && request.resource.data.recipient.name.size() > 0
        && request.resource.data.recipient.name.size() <= 120
        && request.resource.data.recipient.phone is string
        && request.resource.data.recipient.phone.size() > 0
        && request.resource.data.recipient.phone.size() <= 30
        && request.resource.data.status in ['scheduled', 'sent']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (request.resource.data.status == 'scheduled'
            && request.resource.data.scheduledAt is timestamp
            && request.resource.data.scheduledAt > request.time
            && request.resource.data.sentAt == null)
          ||
          (request.resource.data.status == 'sent'
            && (request.resource.data.scheduledAt == null
              || request.resource.data.scheduledAt is timestamp)
            && request.resource.data.sentAt is timestamp)
        );
    }

    match /connections/{connectionId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument()
        && hasValidConnectionData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsExistingDocument()
        && ownsNewDocument()
        && hasValidConnectionData()
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /contacts/{contactId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument()
        && hasValidContactData()
        && connectionBelongsToUser(request.resource.data.connectionId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsExistingDocument()
        && ownsNewDocument()
        && hasValidContactData()
        && connectionBelongsToUser(request.resource.data.connectionId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /messages/{messageId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument()
        && hasValidMessageData()
        && connectionBelongsToUser(request.resource.data.connectionId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'scheduled' && request.resource.data.sentAt == null)
          ||
          (request.resource.data.status == 'sent'
            && request.resource.data.scheduledAt == null
            && request.resource.data.sentAt == request.time)
        );
      allow update: if ownsExistingDocument()
        && ownsNewDocument()
        && resource.data.status == 'scheduled'
        && request.resource.data.status == 'scheduled'
        && hasValidMessageData()
        && connectionBelongsToUser(request.resource.data.connectionId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.connectionId == resource.data.connectionId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sentAt == resource.data.sentAt
        && request.resource.data.updatedAt == request.time;
    }
  }
}
