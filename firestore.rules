rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    function ownsNewDocument() {
      return isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    function hasValidContactData() {
      return request.resource.data.keys().hasAll([
          'clientId',
          'name',
          'phone',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId',
          'name',
          'phone',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /connections/{connectionId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsExistingDocument() && ownsNewDocument();
    }

    match /contacts/{contactId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument()
        && hasValidContactData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsExistingDocument()
        && ownsNewDocument()
        && hasValidContactData()
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /messages/{messageId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsExistingDocument() && ownsNewDocument();
    }
  }
}
